# Database credentials — DO NOT commit real passwords. Set a strong random value
# in your local `.env` (which is git-ignored). docker-compose requires DB_PASSWORD.
DB_PASSWORD=change-me-strong-random-password
DATABASE_URL=postgresql+asyncpg://prysm:${DB_PASSWORD:-change-me-strong-random-password}@localhost:5432/prysm_note
# The app connects as a non-superuser role so PostgreSQL RLS is enforced (a
# superuser would bypass RLS). DB_APP_PASSWORD is set when the role is created.
DB_APP_USER=prysm_app
DB_APP_PASSWORD=change-me-app-role-password
# Background/system jobs (recurring expansion, calendar pull) connect as a
# non-superuser BYPASSRLS role so they can process all users' data. Set when the
# role is created.
DB_SYSTEM_USER=prysm_system
DB_SYSTEM_PASSWORD=change-me-system-role-password
JWT_SECRET_KEY=your-64-char-hex-string-here-change-me-in-production-abcdef1234567890
ENCRYPTION_KEY=your-44-char-fernet-key-here-change-me-in-producti
CORS_ORIGINS=http://localhost:3000
# "development" (default) exposes /docs + permissive CSP; "production" disables
# /docs and hardens headers. Always set production when deploying.
ENVIRONMENT=development

# LLM API keys (optional — users can provide their own in Settings)
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Google OAuth (optional — for Calendar sync)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub OAuth App (optional — for SSO sign-in)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/settings



# Redis (optional — for distributed rate limiting)
REDIS_URL=

# Deployed commit SHA (set automatically by the deploy workflows; used by
# /api/health + the frontend update banner).
GIT_SHA=

# SMTP (optional — for EE contact form and feature request emails)
# SMTP for the core mailer (password reset, contact form). Optional: BREVO_API_KEY
# takes precedence and sends via the Brevo REST API (port 443) instead of SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ADMIN_EMAIL=
BREVO_API_KEY=
# Require email/password accounts to confirm their address via email before
# signing in. SSO accounts are always treated as verified. Requires a working
# mailer (SMTP/BREVO_API_KEY + ADMIN_EMAIL).
REQUIRE_EMAIL_VERIFICATION=false
# OAuth SSO login (optional)
# Backend callback URI registered on the Google/GitHub OAuth apps + frontend origin
OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/oauth/google/callback
APP_ORIGIN=http://localhost:3000
