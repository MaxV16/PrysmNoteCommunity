{
  "name": "prysm-note",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/frontend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "smoke:api": "BASE_URL=${BASE_URL:-http://localhost:8000/api} node scripts/smoke/api-smoke.mjs",
    "smoke:ui": "BASE_URL=${BASE_URL:-http://localhost:3000} node scripts/smoke/ui-smoke.mjs",
    "smoke:ui-mobile": "BASE_URL=${BASE_URL:-http://localhost:3000} node scripts/smoke/ui-smoke-mobile.mjs",
    "smoke:timeline": "BASE_URL=${BASE_URL:-http://localhost:3000} node scripts/smoke/timeline-infinite-smoke.mjs",
    "smoke:timeline-drag": "BASE_URL=${BASE_URL:-http://localhost:3000} node scripts/smoke/timeline-drag-smoke.mjs",
    "smoke:timeline-pan": "BASE_URL=${BASE_URL:-http://localhost:3000} node scripts/smoke/timeline-pan-smoke.mjs",
    "smoke:timeline-touch": "BASE_URL=${BASE_URL:-http://localhost:3000} node scripts/smoke/timeline-touch-smoke.mjs",
    "smoke:marketing": "BASE_URL=${BASE_URL:-http://localhost:3000} node scripts/smoke/marketing-menu-smoke.mjs",
    "smoke:marketing-links": "BASE_URL=${BASE_URL:-http://localhost:3000} node scripts/smoke/marketing-links-smoke.mjs",
    "smoke:marketing-mobile": "BASE_URL=${BASE_URL:-http://localhost:3000} node scripts/smoke/marketing-mobile-smoke.mjs",
    "smoke:404": "BASE_URL=${BASE_URL:-http://localhost:3000} node scripts/smoke/not-found-smoke.mjs",
    "build:desktop": "node scripts/build-desktop.mjs"
  },
  "overrides": {
    "postcss": "^8.5.23"
  },
  "packageManager": "npm@11.16.0",
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "concurrently": "^10.0.4",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "turbo": "^2.10.7",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "electron@42.3.3": true
  }
}
